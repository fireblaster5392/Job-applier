# The apply queue needs a real browser; Microsoft's Playwright image ships Chromium and its libraries.
FROM mcr.microsoft.com/playwright/python:v1.63.0-noble
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
CMD ["python", "-m", "apply.main", "--db", "/app/data/jobs.db"]
