# Copy to .env and fill in. Never commit .env.

# Telegram (step 1): token from @BotFather, chat id from `python -m watcher.telegram_setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude API for resume + cover letter tailoring
ANTHROPIC_API_KEY=

# Where you open the dashboard (adds a "Review" button to Telegram messages), e.g. your Tailscale address
DASHBOARD_URL=http://localhost:8000

# Database: SQLite file now; switch to Postgres when more services write at once
DATABASE_URL=sqlite:///data/jobs.db
# DATABASE_URL=postgresql://jobs:change-me@postgres:5432/jobs
POSTGRES_PASSWORD=change-me

# Gmail (step 6), Apollo / SERP (step 5): added when those steps are built
