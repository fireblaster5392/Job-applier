# Copy to .env and fill in. Never commit .env.

# Telegram (step 1): token from @BotFather, chat id from `python -m watcher.telegram_setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude API for resume + cover letter tailoring
ANTHROPIC_API_KEY=

# Where you open the dashboard (adds a "Review" button to Telegram messages), e.g. your Tailscale address
DASHBOARD_URL=http://localhost:8000

# Database: SQLite file now; switch to Postgres when more services write at once
DATABASE_URL=sqlite:///data/jobs.db
# DATABASE_URL=postgresql://jobs:change-me@postgres:5432/jobs
POSTGRES_PASSWORD=change-me

# Outreach: finding people (either or both; without them outreach finds no one)
BRAVE_API_KEY=          # api.search.brave.com, for LinkedIn profile search (free tier available)
APOLLO_API_KEY=         # apollo.io, for work emails (uses a credit per email revealed)

# Email: sending what you approve (SMTP) and reading replies (IMAP, read-only).
# Gmail: turn on 2-step verification, create an app password, and make sure IMAP is on.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=

# Job-search MCP server (docker compose `mcp` service): Host names it answers to, e.g. your Tailscale name
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser agent: login it may use to sign in to / create accounts on application portals like Workday.
# Use a password you don't use anywhere else. Leave blank and those applications come back to you.
APPLY_LOGIN_EMAIL=
APPLY_LOGIN_PASSWORD=
